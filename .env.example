# DocNest — environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project settings (Project Settings → API).
#
# `.env.local` is git-ignored and must never be committed.
#
# The values below are the browser-safe Supabase credentials. Never put a
# service-role key, database password, OAuth client secret or any other
# server-only credential in this file — anything in a VITE_ variable is
# bundled into the JavaScript shipped to every visitor.

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The Supabase anon / publishable key. Safe to expose in the browser when
# Row Level Security is enabled (it is enabled in Phase 6).
VITE_SUPABASE_ANON_KEY=